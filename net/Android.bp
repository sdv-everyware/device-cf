// The product's own modules, in a namespace of their own: Soong reads every Android.bp of the
// tree, and other products must not see these names.
soong_namespace {}

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// The Wi-Fi address from the host instead of DHCP (wlan_static.cpp, net_bringup.sh).
cc_binary {
    name: "wlan_static",
    vendor: true,
    srcs: ["wlan_static.cpp"],
    shared_libs: [
        "libbase",
        "liblog",
    ],
    cflags: ["-Wall", "-Werror"],
}

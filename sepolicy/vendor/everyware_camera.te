# camera-app (packages/services/display_safety/utils/camera-app): the panel's camera tile and full
# view. The emulator has no camera: the app shows its clip (camera-app README, "The clip"); a
# USB camera passed into the VM would be shown instead. A harry zone client started by init after the panel
# (/vendor/etc/init/everyware/everyware_camera.rc): the camera, the GPU's render node, the panel's
# Wayland socket and its own control socket in the panel's runtime directory; no network.
type everyware_camera, domain;
type everyware_camera_exec, exec_type, vendor_file_type, file_type;
# the control socket the panel connects to (har-camera in /data/vendor/everyware/run)
type everyware_camera_socket, file_type, data_file_type;
init_daemon_domain(everyware_camera)

# a camera: V4L2 on /dev/video* (the app opens UVC devices only), found in sysfs by its driver (/sys/class/video4linux/*/device/driver)
allow everyware_camera video_device:chr_file rw_file_perms;
allow everyware_camera sysfs:dir r_dir_perms;
allow everyware_camera sysfs:lnk_file r_file_perms;
allow everyware_camera sysfs:file r_file_perms;

# its design and its clip (/vendor/etc/camera-app)
allow everyware_camera vendor_configs_file:dir r_dir_perms;
allow everyware_camera vendor_configs_file:file r_file_perms;

# harry draws the zones on the GPU's render node and shares the buffers with the panel
allow everyware_camera gpu_device:dir r_dir_perms;
allow everyware_camera gpu_device:chr_file rw_file_perms;
get_prop(everyware_camera, graphics_config_prop)
get_prop(everyware_camera, graphics_config_writable_prop)

# the panel's runtime directory: its Wayland socket (made by the panel, the directory's label),
# and the control socket made there
allow everyware_camera vendor_data_file:dir rw_dir_perms;
allow everyware_camera vendor_data_file:sock_file { write getattr };
allow everyware_camera vendor_harplatform:unix_stream_socket connectto;
allow everyware_camera vendor_harplatform:fd use;
type_transition everyware_camera vendor_data_file:sock_file everyware_camera_socket "har-camera";
allow everyware_camera everyware_camera_socket:sock_file { create unlink setattr getattr write };
allow everyware_camera self:unix_stream_socket { create_stream_socket_perms listen accept };

# the thread that decodes asks the scheduler for half a core's capacity (uclamp.min)
allow everyware_camera self:process setsched;

# harry renders through ANGLE and minigbm as the panel does: the DRM card (/dev/dri itself has
# the GPU's label here), the GPU's sysfs, gralloc's allocator (binder) and mapper
allow everyware_camera graphics_device:chr_file rw_file_perms;
r_dir_file(everyware_camera, sysfs_gpu)
binder_use(everyware_camera)
hal_client_domain(everyware_camera, hal_graphics_allocator)
allow everyware_camera hal_graphics_mapper_service:service_manager find;
# uclamp.min above the default needs CAP_SYS_NICE
allow everyware_camera self:capability sys_nice;
# read at start by bionic and the tracing libraries, not needed by the camera
dontaudit everyware_camera default_prop:file r_file_perms;
dontaudit everyware_camera zygote_config_prop:file r_file_perms;
dontaudit everyware_camera system_file:file getattr;
# asked for at start by the tracing library (perfetto's daemon) and the graphics stack (the GPU
# statistics service), not needed by the camera
dontaudit everyware_camera traced_producer_socket:sock_file write;
dontaudit everyware_camera traced:unix_stream_socket connectto;
dontaudit everyware_camera gpu_service:service_manager find;

# The board's scripts and AOSP's dhcpclient; the nonsecure KeyMint is labelled by Google's
# sdv_core_cf policy (BoardConfig.mk of sdv_media_cf)
/vendor/bin/net_bringup\.sh      u:object_r:net_bringup_exec:s0
/vendor/bin/dhcpclient           u:object_r:dhcpclient_exec:s0
/vendor/bin/everyware-browser\.sh u:object_r:everyware_browser_exec:s0

# the panel's other processes (everyware_camera.te, everyware_game.te)
/vendor/bin/camera_app           u:object_r:everyware_camera_exec:s0
/vendor/bin/doom_app             u:object_r:everyware_game_exec:s0
/data/vendor/everyware/doom(/.*)? u:object_r:everyware_game_data_file:s0

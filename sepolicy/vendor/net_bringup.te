# net/net_bringup.sh, the setup_wifi it runs and its wpa_supplicant; permissive while the
# denials are collected, as on the RB3
type net_bringup, domain;
type net_bringup_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(net_bringup)
permissive net_bringup;
domain_auto_trans(net_bringup, dhcpclient_exec, dhcpclient)

# The board's init without the framework: Wi-Fi with DHCP and the clock, as the RB3's
# init.sdv_db845c.rc does them. Cuttlefish loads every kernel module in the first stage and its
# clock is right from the start, so there is nothing to wait for.

# the framework creates these on zygote-start, which never comes here
on post-fs-data
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi

on boot
    start vendor.net_bringup
    start chronyd

# Wi-Fi with DHCP: virt_wifi on the Wi-Fi tap, wpa_supplicant, dhcpclient (net/net_bringup.sh)
service vendor.net_bringup /vendor/bin/net_bringup.sh
    user root
    group system wifi inet net_admin net_raw
    disabled
    oneshot

# on the lease chronyd resolves its servers again at once instead of backing off for minutes
on property:vendor.net.wlan0.dns1=*
    exec_background - system system -- /product/bin/chrony_refresh.sh wlan0
